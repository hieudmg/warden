# warden-server systemd unit.
#
# Install: see deploy/systemd/README.md.
# Explicit init with trusted HTTPS must complete before manual service startup.
# Management requires passkeys and starts locked on every restart. Network
# restrictions are defense in depth, not an authentication substitute.
# No vault key/password/token belongs in this unit or its environment.
[Unit]
Description=Warden Hub management server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=warden
Group=warden

# Creates /var/lib/warden (state) and /etc/warden (configuration) and
# grants the service write access to the former.
StateDirectory=warden
ConfigurationDirectory=warden
# The running service must not modify its own configuration/TLS key material.
# Read-only wins over ConfigurationDirectory's write grant for the same path.
ReadOnlyPaths=/etc/warden

# Optional non-secret overrides only. Missing HTTPS config/identity fails closed.
EnvironmentFile=-/etc/warden/warden-server.env
ExecStart=/usr/local/bin/warden-server serve --config=/etc/warden/server.json

UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/warden
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
